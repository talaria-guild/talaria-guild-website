# Everything the build does not need. Keeping the context small is not just
# speed: node_modules built on macOS would shadow the Linux `npm ci` install in
# the deps stage and produce an image that fails at runtime on native bindings.
node_modules
.next
out
build

.git
.github
.claude
.omc
deploy

.env
.env*.local
*.pem

npm-debug.log*
yarn-debug.log*
yarn-error.log*

.DS_Store
.vercel
.turbo
*.tsbuildinfo
coverage
README.md
